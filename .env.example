# Clicko Environment Configuration
# Copy this file and export variables in your shell, or load with your preferred .env tool.
# Clicko does NOT auto-load .env files — export variables manually or use a shell wrapper.
#
# PowerShell one-liner to load this file:
#   Get-Content .env | ForEach-Object {
#       if ($_ -match '^\s*([^#][^=]*)=(.*)$') {
#           [System.Environment]::SetEnvironmentVariable($Matches[1].Trim(), $Matches[2].Trim(), 'Process')
#       }
#   }

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# Log verbosity level: DEBUG | INFO | WARNING | ERROR | CRITICAL
CLICKO_LOG_LEVEL=INFO

# Path to the rotating log file (10 MB per file, 5 backups kept)
# Relative to the working directory when Clicko starts.
CLICKO_LOG_FILE=logs/clicko.log

# ---------------------------------------------------------------------------
# Web Dashboard (clicko web / clicko serve --web)
# ---------------------------------------------------------------------------

# Host address to bind the Starlette web server.
# Use 127.0.0.1 (default) for local-only access.
# WARNING: Setting 0.0.0.0 exposes the dashboard on your network — only do
# this on a trusted LAN with no external access.
CLICKO_HOST=127.0.0.1

# HTTP port for the web dashboard.
CLICKO_PORT=8000

# ---------------------------------------------------------------------------
# Safety & Approval
# ---------------------------------------------------------------------------

# Human-in-the-loop approval gating.
# When set to true, Clicko pauses before every system-modifying action and
# waits for an explicit approval_respond(approved=true) MCP call.
# Recommended: true for unattended/production use; false for development.
CLICKO_REQUIRE_APPROVAL=false
